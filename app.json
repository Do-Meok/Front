{
  "expo": {
    "name": "DoMeok",
    "slug": "DoMeok",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Domeok.png",
    "scheme": "domeok",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/Domeok.png",
        "backgroundImage": "./assets/images/Domeok.png",
        "monochromeImage": "./assets/images/Domeok.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "domeok"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "domeok"
            }
          ]
        }
      ],
      "package": "com.hwanghotae.DoMeok",
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Domeok.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "영수증 이미지를 선택하기 위해 사진 라이브러리 접근 권한이 필요합니다.",
          "cameraPermission": "영수증을 촬영하기 위해 카메라 접근 권한이 필요합니다."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Domeok.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3621eba1-b287-4808-8da4-81bfdafcb809"
      }
    },
    "owner": "domeok"
  }
}
